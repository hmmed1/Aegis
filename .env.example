# --- Central server ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
JWT_SECRET=replace-with-a-long-random-string
SESSION_TTL_SECONDS=43200
COOKIE_SECURE=true
ENV=production

# Comma-separated sensor_id:key pairs. Every sensor worker's SENSOR_ID/SENSOR_KEY
# below must have a matching entry here.
SENSOR_KEYS=home-pc:changeme,office:changeme2

# --- Sensor worker (used by docker-compose's `sensor` service) ---
SENSOR_ID=home-pc
SENSOR_KEY=changeme
SERVER_URL=http://localhost:8000
IFACE=
SUBNET=192.168.1.0/24
